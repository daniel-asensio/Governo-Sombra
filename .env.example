# Base de dados (SQLite por omissão)
GS_DATABASE_URL=sqlite:///var/governo_sombra.db

# Recolha automática (minutos entre recolhas) quando o servidor corre com GS_SCHEDULER=1
GS_SCHEDULER=0
GS_INGEST_INTERVAL_MIN=60

# Identificação nos pedidos HTTP às fontes oficiais
GS_USER_AGENT=GovernoSombra/0.1 (+https://github.com/daniel-asensio/Governo-Sombra)

# Resumos e classificação com IA (opcional)
# ANTHROPIC_API_KEY=sk-ant-...
GS_IA_MODELO=claude-opus-5

# Envio do resumo diário por email (opcional)
# GS_SMTP_HOST=smtp.example.com
# GS_SMTP_PORT=587
# GS_SMTP_USER=
# GS_SMTP_PASSWORD=
# GS_EMAIL_DESTINO=
